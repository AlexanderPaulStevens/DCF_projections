# Production Configuration for DCF Projections on Google App Engine
# Copy this file to config.env and update with your actual GCP project values

# GCP Project Configuration
GCP_PROJECT_ID=horizon-gcloud-eu
GCP_REGION=europe-west1

# Backend App Engine Configuration
BACKEND_SERVICE_NAME=backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# Frontend App Engine Configuration
FRONTEND_SERVICE_NAME=frontend
FRONTEND_PORT=8080

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# Production URLs (update with your actual App Engine URLs)
PRODUCTION_BACKEND_URL=https://backend-dot-horizon-gcloud-eu.appspot.com
PRODUCTION_FRONTEND_URL=https://frontend-dot-horizon-gcloud-eu.appspot.com

# Frontend Environment Variables
REACT_APP_PRODUCTION_API_URL=https://backend-dot-horizon-gcloud-eu.appspot.com
REACT_APP_API_HOST=backend-dot-horizon-gcloud-eu.appspot.com
REACT_APP_API_PORT=443

# Cloud Storage Configuration (for company data)
CLOUD_STORAGE_BUCKET=horizon-gcloud-eu-company-data
CLOUD_STORAGE_REGION=europe-west1

# Security Configuration
CORS_ORIGINS=https://frontend-dot-horizon-gcloud-eu.appspot.com,https://horizon-gcloud-eu.appspot.com
